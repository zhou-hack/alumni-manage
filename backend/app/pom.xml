<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.alumni</groupId>
        <artifactId>alumni-platform</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>alumni-app</artifactId>
    <name>alumni-app</name>
    <description>启动模块：唯一 Spring Boot 应用（127.0.0.1:8080），产物 alumni-platform.jar</description>

    <dependencies>
        <!-- 公共底座：统一响应/错误码/JWT 验签/全平台唯一 SecurityFilterChain -->
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-common</artifactId>
            <version>0.1.0</version>
        </dependency>

        <!-- 业务模块（传递携带各自专属依赖：POI/thumbnailator/redis 等） -->
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-auth</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-dicts</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-attachments</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-archives</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-reviews</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-stats</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-consents</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-honors</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-showcase</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-drafts</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-announcement</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-outstanding</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-directory</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-wall</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-screen</artifactId>
            <version>0.1.0</version>
        </dependency>

        <!-- P1 业务模块 -->
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-counselors</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-teachers</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-tags</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-notifications</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-admin</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-audit</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-photo</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.alumni</groupId>
            <artifactId>alumni-orgsync</artifactId>
            <version>0.1.0</version>
        </dependency>

        <!-- 运行时基础设施 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>alumni-platform</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
